{
  "name": "shadowarmy",
  "version": "0.0.0",
  "private": true,
  "description": "One human. An army of AI agents that builds software on GitHub.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "lint": "npm run lint:eslint && npm run lint:workflows && npm run lint:shell",
    "lint:eslint": "eslint .",
    "lint:workflows": "actionlint .github/workflows/*.yml template/.github/workflows/*.yml && node scripts/check-workflow-expressions.ts",
    "lint:shell": "bash scripts/lint-shell.sh"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  }
}
